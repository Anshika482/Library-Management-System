# ===========================================================================
#  Environment template for the production profile
# ===========================================================================
#  Copy to backend/.env - which git ignores - and fill in the blanks. Never
#  commit a filled-in copy. Used with:
#
#      docker run --env-file backend/.env ...
#
#  Write values without quotes: --env-file passes them literally. A required
#  value left blank stops the application at startup, on purpose. See
#  README.md for what each variable does.
# ===========================================================================

# ---- Required -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# JDBC URL of an existing database. TLS must be required (sslMode=REQUIRED,
# VERIFY_CA or VERIFY_IDENTITY); no credentials in the URL.
DB_URL=jdbc:mysql://db.example.invalid:3306/library_db?sslMode=VERIFY_IDENTITY

# A dedicated account with rights to create and alter tables in that database.
DB_USERNAME=
DB_PASSWORD=

# At least 32 bytes of private, random text.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# ---- Optional (defaults shown) --------------------------------------------
# The JVM must run in this zone; the Docker image pins Asia/Kolkata.
APP_TIME_ZONE=Asia/Kolkata

# Comma-separated exact browser origins, such as https://library.example.invalid.
CORS_ALLOWED_ORIGINS=

FINE_DAILY_RATE=1.00
JWT_REFRESH_TOKEN_VALIDITY=P7D
