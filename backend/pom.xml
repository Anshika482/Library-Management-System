<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        The Spring Boot parent POM. It does two big things for us:
        1. Dependency management - it already knows the correct, mutually
           compatible version of every Spring/Hibernate/Jackson/MySQL library,
           which is why most <dependency> blocks below have no <version> tag.
        2. Plugin configuration - sensible defaults for compiling, testing and
           packaging a Spring Boot application.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- always look the parent up in the repository, not on disk -->
    </parent>

    <!-- Coordinates that uniquely identify this project in the Maven world. -->
    <groupId>com.library</groupId>
    <artifactId>library-management-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>library-management-system</name>
    <description>Library Management System - REST backend (Spring Boot + MySQL)</description>

    <properties>
        <!--
            Java 21 is the current Long Term Support release. Your machine has
            JDK 24 installed, which compiles Java 21 bytecode perfectly well, so
            this builds today AND stays on a supported LTS baseline.
        -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- One version for all three JJWT artifacts; they must always match. -->
        <jjwt.version>0.13.0</jjwt.version>

        <!--
            The library's business time zone. Due dates, overdue status and
            fines follow the JVM's date, so the JVM is started in this zone for
            the tests and for spring-boot:run rather than inheriting the
            machine's. Keep it equal to APP_TIME_ZONE.
        -->
        <app.time-zone>Asia/Kolkata</app.time-zone>
    </properties>

    <dependencies>

        <!--
            Spring Web: embedded Tomcat server + Spring MVC.
            This is what lets us expose REST endpoints (@RestController) and
            serve JSON. Without it the app would start and immediately exit.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Data JPA: Hibernate (the ORM), the JPA API and the HikariCP
            connection pool. This is how Java objects will be mapped to MySQL
            tables later, and how we get repository interfaces for free.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Bean Validation: the jakarta.validation annotations
            (@NotBlank, @Size, @NotNull, @Min) plus Hibernate Validator, the
            engine that actually checks them. Spring Boot wires the two
            together, so a request body marked @Valid is rejected before it
            ever reaches our service code.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Spring Security: authentication and authorization for the whole
            application. Adding the starter alone already changes runtime
            behaviour, because Spring Boot auto configures a default filter
            chain that demands a login for every endpoint and prints a
            generated password to the console at startup. Nothing is configured
            here yet, so that default is what applies until a SecurityConfig
            is written in a later step.

            No version tag: the Spring Boot parent picks the exact Spring
            Security release it was built and tested against.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            JJWT: creates and verifies JSON Web Tokens. Split across three
            artifacts on purpose. Only jjwt-api is compiled against, so our code
            depends on the interfaces and not on one particular implementation.
            jjwt-impl and jjwt-jackson are runtime scope: the first is the engine
            that does the signing, the second teaches it to read and write the
            JSON payload using the Jackson library Spring Boot already ships.
            Compiling against them would let an import of an internal class slip
            in, which would break on the next upgrade.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            The MySQL JDBC driver. "runtime" scope = not needed to compile our
            code, only needed when the application actually talks to the database.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway: versioned database migrations. The SQL files under
            src/main/resources/db/migration are the production schema's source
            of truth. At startup Spring Boot applies, in version order, any the
            database has not yet recorded, and finishes before Hibernate is
            built - so in production Hibernate only ever validates the result.

            Two artifacts, because Flyway 10 moved support for each database
            out of the core into a module of its own: with flyway-core alone,
            startup fails with "Unsupported Database: MySQL". Neither carries a
            version - the Spring Boot parent manages both, at Flyway 11.7.2 for
            Spring Boot 3.5.16.

            Being on the classpath does not switch it on everywhere.
            application.properties turns it off for development and the tests,
            whose databases ddl-auto built, and application-prod.properties
            turns it on.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!--
            Actuator: health and readiness endpoints for whatever runs this
            application - a load balancer, an orchestrator, a monitor - to ask
            whether it is alive and whether it can take traffic.

            Actuator can publish far more than that (environment, configuration,
            beans, heap dumps), so on its own it is a liability. What is actually
            reachable is decided in application.properties: only health and
            info, with no details. No version tag - the Spring Boot parent
            manages it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            DevTools: automatically restarts the app when you recompile, so you
            do not have to stop/start the server after every change.
            "optional" means it is never shipped to whoever uses your jar.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Lombok: generates getters, setters, constructors, builders and
            toString at compile time from annotations, so our future entity and
            DTO classes stay short and readable.
            "provided" = compile-time only, not part of the final jar.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Testing: JUnit 5, AssertJ, Mockito and Spring's test support.
            "test" scope = only on the classpath while running tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!--
                Java 23 and later no longer run annotation processors that are
                merely present on the classpath - javac must be told about them
                explicitly. Without this block Lombok is silently skipped: the
                build still succeeds, but Book.class comes out with its fields
                and no getters, setters or toString, and the first class that
                calls book.getTitle() fails with "cannot find symbol".

                Listing Lombok under <annotationProcessorPaths> makes Maven pass
                the processor path to javac explicitly, which re-enables it. The
                version comes from ${lombok.version}, the property the Spring Boot
                parent already manages, so the dependency version is unchanged.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                The test JWT signing secret.

                jwt.secret is now ${JWT_SECRET} with no fallback, so the five
                test classes that start a Spring context would fail to resolve
                it on a machine where the variable is not set - which is every
                machine, since the whole point of the change is that no default
                exists. Supplying it here keeps the suite runnable without
                putting a value back into application.properties, where it
                would be production configuration again.

                It is passed as a real environment variable rather than a system
                property so the tests resolve it by exactly the path production
                does. The value is a fixed, obviously-labelled test string: it
                signs nothing outside the test JVM, and no test asserts anything
                about the secret itself, only about tokens signed with whatever
                is configured. DB_PASSWORD is deliberately NOT set here - the
                integration tests use the developer's own MySQL credentials from
                the environment, and hard-coding a database password into the
                build is the practice this step exists to remove.

                JWT_ISSUER and JWT_AUDIENCE are supplied for the same reason:
                both are required with no fallback. Their values are plainly
                labelled test names that no real deployment would use, so a
                token minted in a test is refused everywhere else.

                The BOOTSTRAP_ADMIN_* values exist because a context that starts
                against a schema with no accounts must create its first
                administrator, and refuses to start without these settings -
                exactly as production does. Some test classes use schemas of
                their own that begin empty; with these values they bootstrap a
                plainly labelled test administrator once and skip it on every
                later run. The password is a dummy that is valid under the API's
                rules and protects nothing outside a throwaway test schema. A
                test that needs different values overrides them itself.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests run in the business time zone, whatever the machine's is. -->
                    <argLine>-Duser.timezone=${app.time-zone}</argLine>
                    <environmentVariables>
                        <JWT_SECRET>test-only-jwt-signing-secret-not-used-by-any-environment</JWT_SECRET>
                        <JWT_ISSUER>test-only-jwt-issuer</JWT_ISSUER>
                        <JWT_AUDIENCE>test-only-jwt-audience</JWT_AUDIENCE>
                        <BOOTSTRAP_ADMIN_LIBRARY>Test-only Bootstrap Library</BOOTSTRAP_ADMIN_LIBRARY>
                        <BOOTSTRAP_ADMIN_USERNAME>test-only-bootstrap-admin</BOOTSTRAP_ADMIN_USERNAME>
                        <BOOTSTRAP_ADMIN_EMAIL>test-only-bootstrap-admin@example.invalid</BOOTSTRAP_ADMIN_EMAIL>
                        <BOOTSTRAP_ADMIN_PASSWORD>test-only-bootstrap-password</BOOTSTRAP_ADMIN_PASSWORD>
                    </environmentVariables>
                </configuration>
            </plugin>
            <!--
                Packages the application into a single executable "fat jar"
                (mvn package) and provides the mvn spring-boot:run command.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Duser.timezone=${app.time-zone}</jvmArguments>
                    <excludes>
                        <!-- Lombok disappears after compilation; keep it out of the jar. -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
